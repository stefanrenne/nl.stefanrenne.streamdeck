  "drivers": [
    {
      "name": {
        "en": "Network Dock"
      },
      "class": "button",
      "capabilities": [
        "onoff",
        "dim",
        "dashboard"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "discovery": "network-dock",
      "images": {
        "small": "/drivers/network-dock/assets/images/small.png",
        "large": "/drivers/network-dock/assets/images/large.png",
        "xlarge": "/drivers/network-dock/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "network-dock",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Device information",
            "nl": "Apparaatinformatie"
          },
          "children": [
            {
              "id": "ipAddress",
              "type": "text",
              "label": {
                "en": "IP Address",
                "nl": "IP-adres"
              },
              "value": ""
            },
            {
              "id": "name",
              "type": "label",
              "label": {
                "en": "Connected Device",
                "nl": "Aangesloten Apparaat"
              },
              "value": ""
            },
            {
              "id": "serial",
              "type": "label",
              "label": {
                "en": "Serial number",
                "nl": "Serienummer"
              },
              "value": ""
            },
            {
              "id": "firmware",
              "type": "label",
              "label": {
                "en": "Firmware Version",
                "nl": "Firmwareversie"
              },
              "value": ""
            },
            {
              "id": "columns",
              "type": "number",
              "label": {
                "en": "Columns",
                "nl": "Kolommen"
              },
              "value": 0,
              "min": 0
            },
            {
              "id": "rows",
              "type": "number",
              "label": {
                "en": "Rows",
                "nl": "Rijen"
              },
              "value": 0,
              "min": 0
            }
          ]
        }
      ]
    }
  ],
  "capabilities": {
    "dashboard": {
      "type": "enum",
      "title": {
        "en": "Dashboard",
        "nl": "Dashboard"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "uiQuickAction": false,
      "values": []
    }
  },
  "discovery": {
    "network-dock": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "elg",
        "protocol": "tcp"
      },
      "id": "{{txt.md}}",
      "conditions": [
        [
          {
            "field": "txt.md",
            "match": {
              "type": "regex",
              "value": ".*Network Dock.*"
            }
          }
        ]
      ]
    }
  }
